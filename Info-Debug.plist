<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Debug builds deliberately carry no Sparkle feed.

	A Debug build has the same CFBundleVersion as the shipping app but a
	different bundle layout (different executable name, no top-level
	CodeResources), and Sparkle picks deltas by CFBundleVersion string alone.
	So every delta the production appcast offers is one this bundle can never
	apply — it would fail the source-tree hash check, and before Sparkle 2.9.1
	that failure aborted the process outright.

	SUEnableAutomaticChecks is present and false rather than simply omitted:
	with the key absent, Sparkle asks the user whether to check automatically
	on the next launch instead of staying quiet.
-->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.khm.snippets.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snippets</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Snippets Encrypted Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.khm.snippets.encrypted-backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>snippetsbackup</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.khm.snippets.encrypted-backup</string>
			</dict>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New Snippet</string>
			</dict>
			<key>NSMessage</key>
			<string>makeSnippetFromSelection</string>
			<key>NSPortName</key>
			<string>Snippets</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>Text</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open Snippets App</string>
			</dict>
			<key>NSMessage</key>
			<string>openSnippetsFromService</string>
			<key>NSPortName</key>
			<string>Snippets</string>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Secure Paste with Snippets…</string>
			</dict>
			<key>NSMessage</key>
			<string>securePasteFromService</string>
			<key>NSPortName</key>
			<string>Snippets</string>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
	<key>SUEnableAutomaticChecks</key>
	<false/>
</dict>
</plist>
