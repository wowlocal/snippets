#!/bin/bash

set -e

cd "$(dirname "$0")"

PROJECT_DIR="$(cd .. && pwd)"

# Change only the macOS target; iOS has an independent release cadence.
BUMP="${1:-patch}"
VERSION_JSON="$(python3 "$PROJECT_DIR/scripts/project-version.py" macos --bump "$BUMP")"
NEW_VERSION="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["version"])' <<< "$VERSION_JSON")"
NEW_BUILD="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["build"])' <<< "$VERSION_JSON")"
echo "New macOS version: $NEW_VERSION (build $NEW_BUILD)" >&2

# Commit
cd "$PROJECT_DIR"
git commit --quiet --only -m "Bump version to ${NEW_VERSION} (build ${NEW_BUILD})" -- Snippets.xcodeproj/project.pbxproj

# Tag
TAG="v${NEW_VERSION}"
git tag "$TAG"

echo "$NEW_VERSION"
