#!/bin/bash

set -e

cd "$(dirname "$0")"
source common.sh

# Load .env if present
if [ -f .env ]; then
    gray_text
    echo "Loading environment from .env"
    normal_text
    set -a
    source .env
    set +a
fi

# Validate required env vars
MISSING=()
[ -z "$S3_BUCKET" ] && MISSING+=("S3_BUCKET")
[ -z "$S3_ENDPOINT" ] && MISSING+=("S3_ENDPOINT")
[ -z "$S3_REGION" ] && MISSING+=("S3_REGION")
[ -z "$S3_PREFIX" ] && MISSING+=("S3_PREFIX")
[ -z "$AWS_ACCESS_KEY_ID" ] && MISSING+=("AWS_ACCESS_KEY_ID")
[ -z "$AWS_SECRET_ACCESS_KEY" ] && MISSING+=("AWS_SECRET_ACCESS_KEY")

if [ ${#MISSING[@]} -gt 0 ]; then
    red_text
    echo "Missing required environment variables: ${MISSING[*]}"
    echo "Set them in Distribution/.env or export them before running."
    normal_text
    exit 1
fi

# Validate required tools
for tool in aws curl python3; do
    if ! command -v "$tool" &>/dev/null; then
        red_text
        echo "Required tool not found: $tool"
        normal_text
        exit 1
    fi
done

if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ] && ! command -v gh &>/dev/null; then
    red_text
    echo "Required tool not found: gh (or set GH_TOKEN/GITHUB_TOKEN)"
    normal_text
    exit 1
fi

if [ -n "$(git -C "$PROJECT_DIR" status --porcelain)" ]; then
    red_text
    echo "Working tree is dirty. Commit or stash changes before releasing."
    normal_text
    exit 1
fi

ARCHIVE_PATH="archives/Snippets.xcarchive"
APP_PATH="exported-apps/Snippets.app"
ORIGINAL_HEAD=$(git -C "$PROJECT_DIR" rev-parse HEAD)
BUMP_COMMIT=""
TAG=""
PUBLISHING_STARTED=0
RELEASE_COMPLETE=0

function rollback_failed_release() {
    local status=$?
    if [ "$status" -eq 0 ] || [ "$RELEASE_COMPLETE" -eq 1 ]; then
        return
    fi

    if [ "$PUBLISHING_STARTED" -eq 1 ]; then
        orange_text
        echo "Release failed after publishing started; leaving git state intact for manual recovery."
        normal_text
        return
    fi

    if [ -n "$TAG" ] && git -C "$PROJECT_DIR" tag -l "$TAG" | grep -q "^${TAG}$"; then
        orange_text
        echo "Deleting unpublished local tag $TAG"
        normal_text
        git -C "$PROJECT_DIR" tag -d "$TAG" >/dev/null
    fi

    if [ -n "$BUMP_COMMIT" ] && [ "$(git -C "$PROJECT_DIR" rev-parse HEAD)" = "$BUMP_COMMIT" ]; then
        orange_text
        echo "Removing unpublished version bump commit $BUMP_COMMIT"
        normal_text
        git -C "$PROJECT_DIR" reset --hard "$ORIGINAL_HEAD" >/dev/null
    fi
}

function github_access_token() {
    if [ -n "${GH_TOKEN:-}" ]; then
        echo "$GH_TOKEN"
        return
    fi

    if [ -n "${GITHUB_TOKEN:-}" ]; then
        echo "$GITHUB_TOKEN"
        return
    fi

    gh auth token
}

function github_repo_slug() {
    local remote_url
    remote_url=$(git -C "$PROJECT_DIR" remote get-url origin)

    case "$remote_url" in
        git@github.com:*.git)
            echo "${remote_url#git@github.com:}" | sed -E 's/\.git$//'
            ;;
        git@github.com:*)
            echo "${remote_url#git@github.com:}"
            ;;
        https://github.com/*.git)
            echo "${remote_url#https://github.com/}" | sed -E 's/\.git$//'
            ;;
        https://github.com/*)
            echo "${remote_url#https://github.com/}"
            ;;
        *)
            red_text
            echo "Cannot derive GitHub repo from origin URL: $remote_url"
            normal_text
            exit 1
            ;;
    esac
}

function json_field() {
    local file="$1"
    local field="$2"
    python3 - "$file" "$field" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle)

for part in sys.argv[2].split("."):
    value = value[part]

print(value)
PY
}

function asset_id_by_name() {
    local file="$1"
    local asset_name="$2"
    python3 - "$file" "$asset_name" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    release = json.load(handle)

for asset in release.get("assets", []):
    if asset.get("name") == sys.argv[2]:
        print(asset.get("id", ""))
        break
PY
}

function url_encode() {
    python3 - "$1" <<'PY'
import sys
import urllib.parse

print(urllib.parse.quote(sys.argv[1], safe=""))
PY
}

function write_release_payload() {
    local payload_path="$1"
    local release_tag="$2"
    local target_branch="$3"
    local release_title="$4"

    python3 - "$release_tag" "$target_branch" "$release_title" > "$payload_path" <<'PY'
import json
import sys

print(json.dumps({
    "tag_name": sys.argv[1],
    "target_commitish": sys.argv[2],
    "name": sys.argv[3],
    "draft": False,
    "prerelease": False,
    "generate_release_notes": True,
}))
PY
}

function github_request() {
    local method="$1"
    local url="$2"
    local output_path="$3"
    local body_path="${4:-}"
    local token="$GITHUB_RELEASE_TOKEN"
    local args=(
        --silent
        --show-error
        --location
        --request "$method"
        --output "$output_path"
        --write-out "%{http_code}"
        --header "Authorization: Bearer ${token}"
        --header "Accept: application/vnd.github+json"
        --header "X-GitHub-Api-Version: 2022-11-28"
    )

    if [ -n "$body_path" ]; then
        args+=(--header "Content-Type: application/json" --data-binary "@${body_path}")
    fi

    curl "${args[@]}" "$url"
}

function print_github_error() {
    local action="$1"
    local status="$2"
    local response_path="$3"

    red_text
    echo "GitHub ${action} failed (HTTP ${status})"
    if [ -s "$response_path" ]; then
        python3 - "$response_path" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        payload = json.load(handle)
    print(json.dumps(payload, indent=2))
except Exception:
    with open(sys.argv[1], encoding="utf-8", errors="replace") as handle:
        print(handle.read())
PY
    fi
    normal_text
}

function create_github_release() {
    local release_tag="$1"
    local dmg_path="$2"
    local release_title="$3"
    local target_branch="$4"
    local repo
    local api_base
    local uploads_base
    local payload
    local response
    local upload_response
    local delete_response
    local status
    local release_id
    local release_url
    local asset_name
    local asset_name_encoded
    local existing_asset_id

    repo=$(github_repo_slug)
    api_base="${GITHUB_API_URL:-https://api.github.com}"
    uploads_base="${GITHUB_UPLOADS_URL:-https://uploads.github.com}"
    GITHUB_RELEASE_TOKEN=$(github_access_token)

    payload=$(mktemp "${TMPDIR:-/tmp}/snippets-release-payload.XXXXXX")
    response=$(mktemp "${TMPDIR:-/tmp}/snippets-release-response.XXXXXX")
    upload_response=$(mktemp "${TMPDIR:-/tmp}/snippets-upload-response.XXXXXX")
    delete_response=$(mktemp "${TMPDIR:-/tmp}/snippets-delete-response.XXXXXX")

    write_release_payload "$payload" "$release_tag" "$target_branch" "$release_title"

    status=$(github_request GET "${api_base}/repos/${repo}/releases/tags/${release_tag}" "$response")
    if [ "$status" = "404" ]; then
        status=$(github_request POST "${api_base}/repos/${repo}/releases" "$response" "$payload")
        if [ "$status" != "201" ]; then
            print_github_error "release creation" "$status" "$response"
            exit 1
        fi
    elif [ "$status" != "200" ]; then
        print_github_error "release lookup" "$status" "$response"
        exit 1
    fi

    release_id=$(json_field "$response" "id")
    release_url=$(json_field "$response" "html_url")
    asset_name=$(basename "$dmg_path")
    asset_name_encoded=$(url_encode "$asset_name")

    existing_asset_id=$(asset_id_by_name "$response" "$asset_name")
    if [ -n "$existing_asset_id" ]; then
        gray_text
        echo "Replacing existing GitHub release asset: $asset_name"
        normal_text

        status=$(github_request DELETE "${api_base}/repos/${repo}/releases/assets/${existing_asset_id}" "$delete_response")
        if [ "$status" != "204" ]; then
            print_github_error "asset deletion" "$status" "$delete_response"
            exit 1
        fi
    fi

    status=$(curl \
        --silent \
        --show-error \
        --location \
        --request POST \
        --output "$upload_response" \
        --write-out "%{http_code}" \
        --header "Authorization: Bearer ${GITHUB_RELEASE_TOKEN}" \
        --header "Accept: application/vnd.github+json" \
        --header "X-GitHub-Api-Version: 2022-11-28" \
        --header "Content-Type: application/octet-stream" \
        --data-binary "@${dmg_path}" \
        "${uploads_base}/repos/${repo}/releases/${release_id}/assets?name=${asset_name_encoded}")

    if [ "$status" != "201" ]; then
        print_github_error "asset upload" "$status" "$upload_response"
        exit 1
    fi

    GITHUB_RELEASE_URL="$release_url"
    GITHUB_ASSET_URL=$(json_field "$upload_response" "browser_download_url")
}

trap rollback_failed_release EXIT

# Step 1: Bump version
BUMP="${1:-patch}"
orange_text
echo "Step 1/7: Bumping version ($BUMP)..."
normal_text

APP_VERSION_RAW=$(./BumpVersion "$BUMP")
APP_VERSION=$(echo "$APP_VERSION_RAW" | tr -d '\r' | tail -n 1)
if [[ ! "$APP_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    red_text
    echo "Invalid version output from BumpVersion:"
    echo "$APP_VERSION_RAW"
    normal_text
    exit 1
fi
TAG="v${APP_VERSION}"
BUMP_COMMIT=$(git -C "$PROJECT_DIR" rev-parse HEAD)

green_text
echo "Version: $APP_VERSION ($TAG)"
normal_text

# Step 2: Archive
orange_text
echo "Step 2/7: Archiving..."
normal_text

archive_app "$ARCHIVE_PATH"

green_text
echo "Archived to $ARCHIVE_PATH"
normal_text

# Step 3: Export
orange_text
echo "Step 3/7: Exporting..."
normal_text

export_app "$ARCHIVE_PATH" "$APP_PATH"

green_text
echo "Exported to $APP_PATH"
normal_text

green_text
echo "=== Releasing Snippets v${APP_VERSION} ==="
normal_text

DMG_DIR="created-dmgs"
DMG_FILENAME="snippets-${APP_VERSION}.dmg"
DMG_PATH="${DMG_DIR}/${DMG_FILENAME}"

# Step 4: Build DMG (sign, notarize, staple)
orange_text
echo "Step 4/7: Building DMG..."
normal_text
./MakeDMG "$APP_PATH"

if [ ! -f "$DMG_PATH" ]; then
    red_text
    echo "Expected DMG not found at $DMG_PATH"
    normal_text
    exit 1
fi

green_text
echo "DMG created: $DMG_PATH"
normal_text

# Step 5: Generate appcast
orange_text
echo "Step 5/7: Generating appcast..."
normal_text
./GenerateAppcast

if [ ! -f "$DMG_DIR/appcast.xml" ]; then
    red_text
    echo "Appcast not found at $DMG_DIR/appcast.xml"
    normal_text
    exit 1
fi

green_text
echo "Appcast generated"
normal_text

# Step 6: Upload to S3
orange_text
echo "Step 6/7: Uploading to S3..."
normal_text
PUBLISHING_STARTED=1

S3_DMG_DEST="s3://${S3_BUCKET}/${S3_PREFIX}/${DMG_FILENAME}"
S3_APPCAST_DEST="s3://${S3_BUCKET}/${S3_PREFIX}/appcast.xml"
DELTA_FILENAMES=$(grep -oE 'url="[^"]+\.delta"' "$DMG_DIR/appcast.xml" | sed -E 's/^url="([^"]+)".*/\1/' | sed -E 's#.*/##' | sort -u)
DELTA_COUNT=0
for _delta in $DELTA_FILENAMES; do
    DELTA_COUNT=$((DELTA_COUNT + 1))
done

gray_text
echo "  DMG     → $S3_DMG_DEST"
echo "  Appcast → $S3_APPCAST_DEST"
if [ "$DELTA_COUNT" -gt 0 ]; then
    echo "  Deltas  → s3://${S3_BUCKET}/${S3_PREFIX}/*.delta ($DELTA_COUNT file(s))"
else
    echo "  Deltas  → none referenced in appcast"
fi
normal_text

aws s3 cp "$DMG_PATH" "$S3_DMG_DEST" --endpoint-url "$S3_ENDPOINT" --region "$S3_REGION"
aws s3 cp "$DMG_DIR/appcast.xml" "$S3_APPCAST_DEST" --endpoint-url "$S3_ENDPOINT" --region "$S3_REGION"
for DELTA_FILENAME in $DELTA_FILENAMES; do
    DELTA_LOCAL_PATH="${DMG_DIR}/${DELTA_FILENAME}"
    DELTA_DEST="s3://${S3_BUCKET}/${S3_PREFIX}/${DELTA_FILENAME}"
    if [ ! -f "$DELTA_LOCAL_PATH" ]; then
        red_text
        echo "Delta referenced in appcast is missing locally: $DELTA_LOCAL_PATH"
        normal_text
        exit 1
    fi
    aws s3 cp "$DELTA_LOCAL_PATH" "$DELTA_DEST" --endpoint-url "$S3_ENDPOINT" --region "$S3_REGION"
done

green_text
echo "S3 upload complete"
normal_text

# Step 7: Push branch + tag + GitHub release
orange_text
echo "Step 7/7: Pushing branch/tag and creating GitHub release..."
normal_text

cd ..
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" = "HEAD" ]; then
    red_text
    echo "Detached HEAD detected; cannot push version bump commit to a branch."
    normal_text
    exit 1
fi
git push origin "$CURRENT_BRANCH"
git push origin "$TAG"
cd Distribution

green_text
echo "Branch $CURRENT_BRANCH and tag $TAG pushed"
normal_text

create_github_release "$TAG" "$DMG_PATH" "Snippets ${APP_VERSION}" "$CURRENT_BRANCH"
RELEASE_COMPLETE=1

green_text
echo ""
echo "=== Release v${APP_VERSION} complete ==="
echo ""
echo "  DMG:     $DMG_PATH"
echo "  S3:      $S3_DMG_DEST"
echo "  GitHub:  $GITHUB_RELEASE_URL"
echo "  Asset:   $GITHUB_ASSET_URL"
normal_text
