# Development compose only. Generate independent random values; do not reuse
# these credentials or run DATABASE_TLS_MODE=disable in production.
POSTGRES_DB=snippets_sync_dev
POSTGRES_USER=snippets_owner
POSTGRES_PASSWORD=replace-with-owner-password
SNIPPETS_RUNTIME_PASSWORD=replace-with-runtime-password
DATABASE_PORT=5432

SNIPPETS_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
SERVER_INSTANCE_ID=replace-with-one-persistent-uuid
SERVER_VERSION=dev
TOKEN_HMAC_SECRET=replace-with-base64url-32-byte-random
IDENTITY_PEPPER=replace-with-a-different-base64url-32-byte-random

OIDC_ISSUER=https://identity.example.com/
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_AUDIENCE=http://localhost:8080
OIDC_CLIENT_ID=snippets-native
OIDC_SCOPES=openid offline_access
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_MAX_TOKEN_AGE_SECONDS=300
## Set only values your provider documents and actually emits for a verified
## passkey/WebAuthn ceremony. Generic hardware-key possession is insufficient.
OIDC_STEP_UP_AMR_VALUES=webauthn
# Optional provider-specific phishing-resistant ACR values, separated by spaces.
OIDC_STEP_UP_ACR_VALUES=
OIDC_STEP_UP_MAX_AGE_SECONDS=300
OIDC_JWKS_REFRESH_SECONDS=900
OIDC_UNKNOWN_KID_REFRESH_SECONDS=60
OIDC_UNKNOWN_KID_TTL_SECONDS=300

HTTP_IDLE_TIMEOUT_SECONDS=30
HTTP_BODY_TIMEOUT_SECONDS=15
HTTP_MAX_CONNECTIONS=256
HTTP_MAX_CONCURRENT_REQUESTS=128
HTTP_BODY_MEMORY_BUDGET_BYTES=268435456
HTTP_GLOBAL_REQUESTS_PER_SECOND=256
HTTP_GLOBAL_REQUEST_BURST=512
HTTP_PRINCIPAL_REQUESTS_PER_SECOND=30
HTTP_PRINCIPAL_REQUEST_BURST=60
