<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.khm.snippets.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snippets</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Snippets Encrypted Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.khm.snippets.encrypted-backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>snippetsbackup</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.khm.snippets.encrypted-backup</string>
			</dict>
		</dict>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Snippets uses Face ID to reveal encrypted secure snippets.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>SnippetsKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)com.khm.snippets</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
