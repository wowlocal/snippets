    <!-- Shared dialogs (screens-library-editor.md §7, screens-secure.md §4.2, §10) -->
    <string name="dialog_delete_secure_title">Delete “%1$s”?</string>
    <string name="dialog_delete_secure_message">This permanently removes the encrypted snippet from this device and, when sync is on, from your other devices.</string>
    <string name="dialog_clipboard_empty_title">Clipboard Is Empty</string>
    <string name="dialog_clipboard_empty_message">Copy some text, then try again.</string>
    <string name="dialog_screen_lock_title">Set a Screen Lock First</string>
    <string name="dialog_screen_lock_message">Secure snippets use this device’s screen lock: fingerprint, face, PIN, pattern or password. Set one in system settings, then try again.</string>
    <string name="dialog_make_ordinary_title">Make This Snippet Ordinary?</string>
    <string name="dialog_make_ordinary_message">Its content will be decrypted into the ordinary library, where it can be copied, shared, and exported.</string>
    <string name="dialog_make_ordinary_plain_text">This is a plain-text library: the content will be readable in the repository and stay in its history.</string>
    <string name="dialog_sync_opt_in_title">Turn On %1$s Sync?</string>
    <string name="dialog_sync_opt_in_message">Pull to refresh uses %1$s. Snippets encrypts records before uploading them, and you can turn sync off later in Settings.</string>
    <string name="dialog_sync_opt_in_plain_message">Pull to refresh uses Git. Ordinary snippets are saved as readable Markdown files in your repository; secure snippets stay encrypted. You can turn sync off later in Settings.</string>
    <string name="dialog_sync_opt_in_confirm">Turn On</string>
    <string name="dialog_sync_set_up_title">Set Up Sync?</string>
    <string name="dialog_sync_set_up_message">Pull to refresh syncs this library with your other devices. No sync provider is set up on this device yet.</string>
    <string name="dialog_switch_start_title">Start Syncing with %1$s?</string>
    <string name="dialog_switch_start_message">The %1$s on this device will be merged with %2$s, and sync will turn on.</string>
    <string name="dialog_switch_plain_text">This is a plain-text library: ordinary snippets will be readable in the repository.</string>
    <string name="dialog_switch_confirm">Switch and Sync</string>

