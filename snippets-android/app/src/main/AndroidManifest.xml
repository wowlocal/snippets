<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- API 35+: report recordings of the window, so a revealed secure body can hide itself. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <!-- The app stores secrets: no cloud backup and no device-to-device transfer. -->
    <application
        android:name=".SnippetsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Snippets">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Snippets.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Backstop that clears a copied secure body when the app process is gone (D40). -->
        <receiver
            android:name=".platform.ClipClearReceiver"
            android:exported="false" />
    </application>

</manifest>
